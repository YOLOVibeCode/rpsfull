# Ignore node_modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Ignore build outputs
dist/
build/
.next/
out/
.turbo/

# Ignore environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Ignore OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
._*

# Ignore IDE files
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# Ignore test coverage
coverage/
.nyc_output/
*.lcov

# Ignore logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Ignore temporary files
tmp/
temp/
*.tmp
*.temp

# Ignore database files
*.db
*.sqlite
*.sqlite3

# Ignore prisma migrations (keep in git, but ignore generated files)
# migrations/ - DO NOT IGNORE (keep in git)

# Ignore generated Prisma client (will be generated on install)
# Keep schema.prisma in git

# Ignore storybook build
storybook-static/

# Ignore Next.js cache
.next/
out/
.cache/

# Ignore TypeScript cache
*.tsbuildinfo

# Ignore package manager lock files (we use pnpm)
package-lock.json
yarn.lock

# Keep pnpm-lock.yaml (DO NOT IGNORE)
# pnpm-lock.yaml - KEEP IN GIT

# Ignore Docker volumes
.docker/

# Ignore Vercel
.vercel

# Ignore generated types (except from Prisma)
# types/generated/

# Ignore bundler cache
.parcel-cache/

# Ignore Turborepo cache
.turbo/

# Ignore monorepo build artifacts
packages/**/dist/
packages/**/build/
packages/**/.next/

# Ignore test artifacts
test-results/
playwright-report/
test-artifacts/

# Ignore documentation builds
docs/.vitepress/dist/
docs/.vitepress/cache/

# Keep important config files (DO NOT IGNORE)
# .gitignore - KEEP
# .prettierrc - KEEP
# .eslintrc.js - KEEP
# tsconfig.json - KEEP
# package.json - KEEP
# pnpm-workspace.yaml - KEEP
# turbo.json - KEEP

