node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
out/
build/

# Development files
.env.local
.env.development
.env.test

# IDE
.vscode/
.idea/
*.swp
*.swo

# Testing
coverage/
.nyc_output/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Documentation
docs/
*.md
!README.md

# Other packages (only deploy frontend)
packages/backend/
packages/mock-api/
# Note: contracts/ is needed for the build, so don't ignore it

# Git
.git/
.gitignore

# Docker
docker-compose.yml
Dockerfile

# Misc
.DS_Store
*.log

